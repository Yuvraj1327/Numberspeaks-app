# Copy this file to .env for local development.
# Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# Local dev port. Railway sets PORT automatically in production.
PORT=8000

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*

# --- Supabase ---
# Project URL from Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=
# The SERVICE ROLE key (not the anon key) from the same page.
# This key has full read/write access — keep it server-side only,
# never ship it in the Flutter app.
SUPABASE_KEY=

# --- WhatsApp (Meta WhatsApp Cloud API, the default provider) ---
# Permanent access token for your WhatsApp Business app.
WHATSAPP_API_KEY=
# The sending number's ID from Meta's dashboard (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Only change this to point at a different provider/proxy or Graph API version.
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
# Optional: override the default message template without touching code.
# See app/services/whatsapp_templates.py for available placeholders.
WHATSAPP_MESSAGE_TEMPLATE=
