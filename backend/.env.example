# Copy this file to .env for local development.
# Never commit the real .env file.

ENVIRONMENT=development
DEBUG=false

# Local dev port. Railway sets PORT automatically in production.
PORT=8000

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*

# --- Supabase ---
# Project URL from Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=
# The SERVICE ROLE key (not the anon key) from the same page.
# This key has full read/write access — keep it server-side only,
# never ship it in the Flutter app.
SUPABASE_KEY=

# --- No1API (WhatsApp sending) — server-side only ---
# All from the No1API dashboard: Channel -> API Details. Never put these in the Flutter app.
NO1API_BASE_URL=https://crm1.no1api.com/api/meta
NO1API_API_KEY=
NO1API_API_VERSION=v19.0
NO1API_PHONE_NUMBER_ID=
# Seconds to wait between messages in a bulk run (check your provider's rate limit).
# Added to saved 10-digit numbers when sending (WhatsApp needs the country code). Empty = off.
DEFAULT_COUNTRY_CODE=91
NO1API_MIN_INTERVAL_SECONDS=2
WHATSAPP_BULK_MAX=500
