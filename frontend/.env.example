# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit it, same rule as the backend's own
# numberspeaks-backend/.env.example.

# Base URL of the FastAPI backend. Must NOT include /api/v1 (ApiClient
# appends that itself). Android emulator uses 10.0.2.2 for your machine's
# localhost; use your machine's real IP for a physical device, or the
# Railway URL once deployed.
API_BASE_URL=http://10.0.2.2:8000

# Supabase project URL, used only for Auth (login/session) — never for
# direct table access. All report/bonus/WhatsApp data goes through the
# FastAPI backend above, never directly from this app to Supabase tables.
SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON (public) key. Never the service-role key — that stays
# backend-only, in numberspeaks-backend/.env.
SUPABASE_ANON_KEY=your-anon-key
